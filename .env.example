# Copia questo file in ".env" e compila i valori reali.
# ".env" NON va mai committato su Git (aggiungilo a .gitignore).

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=etna_data
DB_USER=postgres
DB_PASSWORD=

# --- NASA FIRMS ---
# Ottieni una MAP_KEY gratuita registrandoti su:
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# --- NASA Earthdata Login ---
# Account gratuito su https://urs.earthdata.nasa.gov/ (NON è la stessa cosa della
# MAP_KEY FIRMS qui sopra). Usa username+password oppure, in alternativa, un token
# generato dal tuo profilo Earthdata (EARTHDATA_TOKEN).
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# EARTHDATA_TOKEN=
